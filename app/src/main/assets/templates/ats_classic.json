{
  "id": "ats_classic",
  "version": 1,
  "schemaVersion": 1,
  "name": "ATS Classic",
  "description": "Standard single-column ATS optimized format designed to pass automated applicant tracking systems without graphical interference.",
  "isPremium": false,
  "isAtsFriendly": true,
  "category": "ats",
  "supportedLanguages": ["en", "ar"],
  "supportsRtl": true,
  "page": {
    "size": "A4",
    "marginTop": 24,
    "marginBottom": 24,
    "marginStart": 28,
    "marginEnd": 28
