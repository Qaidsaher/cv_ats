{
  "id": "ats_modern",
  "version": 1,
  "schemaVersion": 1,
  "name": "ATS Modern Compact",
  "description": "Contemporary ATS compliant single-column layout with high-readability hierarchy, clean skill tags, and optimal line spacing.",
  "isPremium": false,
  "isAtsFriendly": true,
  "category": "ats",
  "supportedLanguages": ["en", "ar"],
  "supportsRtl": true,
  "page": {
    "size": "A4",
    "marginTop": 22,
    "marginBottom": 22,
    "marginStart": 26,
    "marginEnd": 26
  },
  "layout": {
    "type": "single_column",
    "sidebarPosition": "none",
    "sidebarWidth": 0.0,
    "headerStyle": "left_aligned",
    "sectionHeaderStyle": "tech_pill"
  },
  "colors": {
    "primary": "#0F172A",
    "secondary": "#334155",
    "accent": "#0284C7",
    "background": "#FFFFFF",
    "sidebar": "#FFFFFF",
    "textPrimary": "#0F172A",
    "textSecondary": "#475569"
  },
  "typography": {
    "fontFamily": "sans_serif",
    "nameSize": 23,
    "titleSize": 13,
    "sectionTitleSize": 12,
    "bodySize": 9.5,
    "captionSize": 8.5
  },
  "photo": {
    "enabled": false,
    "shape": "none",
    "size": 0
  },
  "sections": [
    "personal",
    "summary",
    "skills",
    "experience",
    "projects",
    "education",
    "certificates",
    "languages"
  ],
  "customizable": {
    "primaryColor": true,
    "secondaryColor": true,
    "fontFamily": true,
    "fontSize": true,
    "spacing": true,
    "showPhoto": false,
    "pageFormat": true
  }
}
